{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taste-kharab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static frontend (Vite build) served by Workers Static Assets.
  // Only /api/* reaches the Worker; everything else is a static file / SPA fallback.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // ~5 roasts / minute / client. Cloudflare keeps these counters at the edge for the
  // window only; our code never stores the key.
  "ratelimits": [
    { "name": "ROAST_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Anonymous aggregate counter for the daily paid-LLM kill switch: one key per day,
  // value is just an integer. No user identifiers.
  "kv_namespaces": [
    { "binding": "COUNTERS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "DAILY_PAID_ROAST_LIMIT": "300",
    // Turnstile *test* site key (always passes). Replace in production.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "LLM_PROVIDERS": "[{\"name\":\"mock\",\"type\":\"mock\",\"paid\":false}]"
  },
  // Cloudflare Web Analytics is cookie-free; enable in dashboard if wanted. No logs of bodies.
  "observability": { "enabled": false }
}
