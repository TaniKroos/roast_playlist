{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taste-kharab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static frontend (Vite build) served by Workers Static Assets.
  // Only /api/* reaches the Worker; everything else is a static file / SPA fallback.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // ~5 roasts / minute / client. Cloudflare keeps these counters at the edge for the
  // window only; our code never stores the key.
  "ratelimits": [
    { "name": "ROAST_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  // Anonymous aggregate counter for the daily paid-LLM kill switch: one key per day,
  // value is just an integer. No user identifiers.
  "kv_namespaces": [
    { "binding": "COUNTERS", "id": "02d939f50a514e279df4b62460de5cda" }
  ],
  "vars": {
    "DAILY_PAID_ROAST_LIMIT": "300",
    // Max tracks sent to the LLM per roast (longer playlists are sampled). ~13 input tokens/track.
    "LLM_MAX_TRACKS": "500",
    // Turnstile *test* site key (always passes). Replace in production.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFL2VqL_z1LVKdr-",
    "LLM_PROVIDERS": "[{\"name\":\"azure\",\"type\":\"azure-openai\",\"baseUrlEnv\":\"AZURE_OPENAI_ENDPOINT\",\"modelEnv\":\"AZURE_OPENAI_DEPLOYMENT\",\"apiKeyEnv\":\"AZURE_OPENAI_API_KEY\",\"apiVersion\":\"2024-12-01-preview\",\"paid\":true,\"omitTemperature\":true,\"reasoningEffort\":\"low\",\"maxTokens\":4000,\"timeoutMs\":30000}]"

  },
  // Cloudflare Web Analytics is cookie-free; enable in dashboard if wanted. No logs of bodies.
  "observability": { "enabled": false },
  "routes": [{ "pattern": "roast.smudgee.xyz", "custom_domain": true }]

}
